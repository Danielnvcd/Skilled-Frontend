# Copia este archivo a `.env.local` para desarrollo local (no se commitea).
# Para producción usar `.env.production` o configurar en Vercel.

# URL del backend Flask. Para dev local apunta al servidor que escucha en :5000/:8000.
VITE_API_URL=http://localhost:5000/api

# Candado temporal de pruebas (src/components/AccessGate.jsx).
# Sin VITE_GATE_ENABLED=true el candado no hace nada.
# VITE_GATE_ENABLED=true
# VITE_GATE_CODE=1234
