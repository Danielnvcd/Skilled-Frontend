# URL pública de la API Flask en producción.
# Debe terminar en /api (sin slash final). Ej.: https://api.skilledmx.cloud/api
#
# En Vercel: configurar también como Environment Variable del proyecto
# (Settings → Environment Variables). El valor en este archivo es solo el
# default por si el build local no la inyecta.
VITE_API_URL=https://api.skilledmx.cloud/api
