{
  "name": "skilled-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "//dependencies": {
    "react-is": "Dependencia DIRECTA a propósito, y con major (19) por delante de React (18). recharts@3 la pide en su versión 19 y npm no la resuelve solo: sin este pin el build de las gráficas falla en runtime. Es también la razón del `--legacy-peer-deps` en vercel.json. Al subir a React 19 se puede quitar esta línea y el flag."
  },
  "overrides": {
    "socket.io-parser": "^4.2.7"
  },
  "//overrides": {
    "socket.io-parser": "socket.io-client@4.8.3 arrastra 4.2.6, afectada por el aviso de agotamiento de memoria con paquetes sin adjuntos (GHSA, severidad alta). 4.2.7 lo corrige y es un parche, sin cambios de API."
  },
  "dependencies": {
    "axios": "^1.19.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-is": "^19.2.6",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
